# MongoDB Connection URI (Optional - automatically falls back to local JSON store if omitted or unreachable)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/event_photo_finder?retryWrites=true&w=majority

# ImageKit Configuration (Optional - automatically falls back to local static storage if omitted)
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint_id
